{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBAppTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DescribeTable",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Scan",
        "dynamodb:Query",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": "arn:aws:dynamodb:*:*:table/shuttlepulse_*"
    },
    {
      "Sid": "DynamoDBListTables",
      "Effect": "Allow",
      "Action": "dynamodb:ListTables",
      "Resource": "*"
    },
    {
      "Sid": "S3UploadFolders",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::shuttlepulse-badminton-storage/player-photos/*",
        "arn:aws:s3:::shuttlepulse-badminton-storage/tournament-images/*",
        "arn:aws:s3:::shuttlepulse-badminton-storage/team-logos/*",
        "arn:aws:s3:::shuttlepulse-badminton-storage/certificates/*"
      ]
    }
  ]
}
